<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SRMR LIGHTING & DECOR | Event Excellence</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .hero-gradient { background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&q=80'); background-size: cover; background-position: center; }
        html { scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900">

    <nav class="bg-white shadow-md fixed w-full z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-orange-600">SRMR <span class="text-gray-800">LIGHTING & DECOR</span></h1>
            <div class="hidden md:flex space-x-8 font-medium">
                <a href="#services" class="hover:text-orange-600">Services</a>
                <a href="#events" class="hover:text-orange-600">Events</a>
                <a href="#booking" class="bg-orange-600 text-white px-5 py-2 rounded-full hover:bg-orange-700">Book Now</a>
            </div>
        </div>
    </nav>

    <header class="hero-gradient h-screen flex items-center justify-center text-center text-white px-4">
        <div>
            <h2 class="text-5xl md:text-7xl font-extrabold mb-4">Illuminating Your Moments</h2>
            <p class="text-xl md:text-2xl mb-8">Premium Lighting, DJ, Band, and Decor for Grand Events</p>
            <a href="#booking" class="bg-orange-600 px-8 py-4 rounded-lg text-lg font-bold hover:bg-orange-700 transition">Start Planning</a>
        </div>
    </header>

    <section id="services" class="py-20 max-w-7xl mx-auto px-4">
        <h3 class="text-3xl font-bold text-center mb-12">Our Services</h3>
        <div class="grid md:grid-cols-4 gap-8">
            <div class="bg-white p-6 rounded-xl shadow-lg text-center">
                <i class="fas fa-lightbulb text-4xl text-orange-500 mb-4"></i>
                <h4 class="text-xl font-bold mb-2">Lighting</h4>
                <p class="text-gray-600">Ambient, Stage, and Theme lighting setups.</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg text-center">
                <i class="fas fa-music text-4xl text-orange-500 mb-4"></i>
                <h4 class="text-xl font-bold mb-2">DJ & Band</h4>
                <p class="text-gray-600">Professional sound systems and live artists.</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg text-center">
                <i class="fas fa-holly-berry text-4xl text-orange-500 mb-4"></i>
                <h4 class="text-xl font-bold mb-2">Decoration</h4>
                <p class="text-gray-600">Floral, Traditional, and Modern decor themes.</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg text-center">
                <i class="fas fa-camera text-4xl text-orange-500 mb-4"></i>
                <h4 class="text-xl font-bold mb-2">Photography</h4>
                <p class="text-gray-600">Capturing memories that last forever.</p>
            </div>
        </div>
    </section>

    <section id="booking" class="py-20 bg-orange-50">
        <div class="max-w-3xl mx-auto px-4 bg-white p-10 rounded-2xl shadow-2xl">
            <h3 class="text-3xl font-bold text-center mb-8 text-orange-600">Book Your Event</h3>
            <form action="https://formspree.io/f/your-id" method="POST" class="grid gap-6">
                <div class="grid md:grid-cols-2 gap-4">
                    <input type="text" name="name" placeholder="Full Name" required class="border p-3 rounded-lg">
                    <input type="tel" name="phone" placeholder="Phone Number" required class="border p-3 rounded-lg">
                </div>
                <select name="event_type" class="border p-3 rounded-lg">
                    <option value="wedding">Wedding</option>
                    <option value="haldi">Haldi / Mehandi</option>
                    <option value="birthday">Birthday</option>
                    <option value="corporate">Corporate Event</option>
                </select>
                <input type="date" name="date" class="border p-3 rounded-lg">
                <textarea name="message" placeholder="Describe your requirements..." rows="4" class="border p-3 rounded-lg"></textarea>
                <button type="submit" class="bg-orange-600 text-white font-bold py-4 rounded-lg hover:bg-orange-700">Check Availability</button>
            </form>
        </div>
    </section>

    <footer class="bg-gray-900 text-white py-10 text-center">
        <p>&copy; 2026 SRMR LIGHTING & DECOR. All Rights Reserved.</p>
    </footer>

</body>
</html>
